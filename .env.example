# Choose one mode. Never commit a real .env file.
# Local emulator mode requires no production credentials:
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=grow-build-local

# For a real Firebase project, set VITE_USE_FIREBASE_EMULATORS=false and
# copy the public web-app configuration shown in Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
